# ---------------------------------------------------------------------------
# 1) REQUIRED — get these from https://my.telegram.org -> "API development tools"
#    (log in with the SAME phone number as the account the bot will run on)
# ---------------------------------------------------------------------------
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Optional: your phone in international format. If set, the first login asks
# only for the code instead of phone + code.
PHONE=+919XXXXXXXXX

# Where the login session is stored (created automatically on first run).
# Keep this file secret — it is a full login to your account!
SESSION_FILE=data/autoreply

# Alternative for headless servers: paste a StringSession instead of a file.
# SESSION_STRING=

# ---------------------------------------------------------------------------
# 2) WHAT THE BOT DOES
# ---------------------------------------------------------------------------
# Reply once to every person who messages you in private
FIRST_REPLY_ENABLED=true

# 0  = reply to a person only ONCE, ever (recommended)
# 30 = they are treated as "new" again if they message after 30 quiet days
FIRST_REPLY_COOLDOWN_DAYS=0

# Send a welcome when Telegram tells you "<name> joined Telegram"
CONTACT_SIGNUP_ENABLED=true

# Greet people who are added to / join your groups (off by default)
GROUP_JOIN_ENABLED=false
GROUP_JOIN_IGNORE_IDS=

# Don't greet people you already have saved in your contacts
SKIP_EXISTING_CONTACTS=false

# Never auto-reply to bots, and never to these user ids (comma separated)
IGNORE_BOTS=true
IGNORE_USER_IDS=

# ---------------------------------------------------------------------------
# 3) PACING / ANTI-FLOOD  (keep these reasonable — spam = account limits)
# ---------------------------------------------------------------------------
REPLY_DELAY_MIN_SECONDS=3
REPLY_DELAY_MAX_SECONDS=12
MAX_MESSAGES_PER_HOUR=60
SEND_TYPING_ACTION=true
MARK_AS_READ=false

# md = Telegram Markdown (default), html = HTML, none = plain text
PARSE_MODE=md

# ---------------------------------------------------------------------------
# 4) FILES / LOGGING
# ---------------------------------------------------------------------------
TEMPLATES_FILE=templates.json
# TEMPLATES_FILE=templates.hinglish.json
DB_PATH=data/state.db
LOG_FILE=logs/autoreply.log
LOG_LEVEL=INFO

# Test everything safely first: nothing is sent, everything is logged
DRY_RUN=false
